{
  "name": "a3em-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "app",
    "firebase"
  ],
  "scripts": {
    "dev": "npm --workspace @a3em/config-schema run build && npm --workspace app run dev",
    "build": "npm --workspace @a3em/config-schema run build && npm --workspace app run build",
    "test": "npm --workspace @a3em/config-schema test",
    "test:helper": "cd card-helper && go test ./...",
    "sync": "npm --workspace @a3em/config-schema run sync",
    "ci": "node tools/sync-extension-manifest.mjs --check && node tools/check-helper-isolation.mjs && npm run lint && npm --workspace @a3em/config-schema run ci && npm --workspace app run build",
    "check-card": "node tools/check-card.mjs",
    "helper:build": "node tools/helper.mjs build",
    "install-helper": "node tools/helper.mjs install",
    "helper-doctor": "node tools/helper.mjs doctor",
    "release:helper": "node tools/release-helper.mjs",
    "sync:extension": "node tools/sync-extension-manifest.mjs",
    "package:extension": "node tools/package-extension.mjs",
    "lint": "eslint .",
    "check:solar": "node tools/check-solar-parity.mjs",
    "test:rules": "npm --workspace @a3em/config-schema run build && npm --workspace @a3em/firebase test",
    "deploy:rules": "node tools/firebase.mjs deploy --only firestore:rules",
    "firebase": "node tools/firebase.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  }
}
