{
  "manifest_version": 3,
  "name": "A3EM Card Helper",
  "version": "0.1.0",
  "description": "Lets the A3EM dashboard mount, inspect, format, and recover SD cards through a local native helper.",
  "minimum_chrome_version": "102",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://config.a3em.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
