{
  "name": "@a3em/card-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Native messaging host for A3EM SD card management: enumerate, inspect, mount, format at a chosen allocation unit, image, and repair. macOS implemented; Windows and Linux stubbed behind a shared platform interface.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "a3em-card-helper": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "install-host": "node ../../tools/install-card-helper.mjs",
    "doctor": "node ../../tools/install-card-helper.mjs --check"
  },
  "dependencies": {
    "@a3em/config-schema": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
